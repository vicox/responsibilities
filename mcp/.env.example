# responsibilities-mcp — configuration
#
# Copy to .env.local for `npm run dev`. .env.local is gitignored; this file is the
# committed template and must never hold a real value.
#
#   Variable               Development              Production
#   ---------------------- ------------------------ ------------------------------
#   PUBLIC_ORIGIN          optional (localhost)     REQUIRED
#   OAUTH_SIGNING_SECRET   required                 REQUIRED, >= 32 bytes   ← secret
#   GOOGLE_CLIENT_ID       required to sign in      REQUIRED
#   GOOGLE_CLIENT_SECRET   required to sign in      REQUIRED                ← secret
#   DATABASE_URL           optional (PGlite)        REQUIRED, Neon pooled   ← secret
#   DEV_DATABASE_DIR       optional (.devdb)        unused
#
# Secrets are set only as encrypted Vercel environment variables scoped to
# Production. Previews get none and fail closed; /mcp and the OAuth endpoints also
# answer 404 on any host other than PUBLIC_ORIGIN's. A production deployment
# missing a value refuses the requests that need it and writes the reason (variable
# names, never values) to stderr — never to the client.
#
# Access is not configured here: who may sign in is the `members` table, managed
# with `npm run admin` (see README). An empty table admits nobody.

# The canonical public origin — scheme, host, port; no path. Every OAuth and MCP
# URL (issuer, /mcp, /oauth/*, discovery documents) is derived from it, never from
# the request's Host header. Defaults to http://localhost:3000 outside production.
PUBLIC_ORIGIN=http://localhost:3000

# HS256 key for access tokens, at least 32 bytes:  openssl rand -base64 48
# Rotating it invalidates every access token; refresh tokens survive (stored as
# SHA-256 hashes, not signed).
OAUTH_SIGNING_SECRET=

# Google OAuth client (type "Web application"), scopes `openid email`. Register
# exactly ONE redirect URI per origin:
#
#   Authorised redirect URI   https://<PUBLIC_ORIGIN host>/oauth/callback
#   Authorised redirect URI   http://localhost:3000/oauth/callback   (local)
#
# A verified email must belong to an active member; its Google account is bound to
# the member row at first sign-in.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Postgres. Production: the Neon POOLED connection string (host contains
# "-pooler", keeps ?sslmode=require). Migrations use the DIRECT URL instead:
#
#   DATABASE_URL=<direct url> npm run db:migrate
#
# Production only checks the schema and never migrates from a request: migrate,
# then deploy. Unset in development: the embedded Postgres below is used.
# DATABASE_URL=

# Development only: where the embedded database (PGlite) keeps its files. The app
# (`npm run dev`) and the operator commands (`npm run db:migrate -- --embedded`,
# `npm run admin -- --embedded`) use the same directory, default .devdb, so a
# member added with the CLI can sign in locally. One process owns it at a time:
# stop `npm run dev` before running an operator command. `memory://` is an
# in-memory database (what the tests use).
DEV_DATABASE_DIR=.devdb
