{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:responsibilities-core:1",
  "title": "Responsibility Core, spec responsibility-core/1",
  "description": "Inputs and outputs of view, step, command and assess. Every string is NFC; integers lie within ±(2^53−1); numbers other than integers occur only in observation rows.",
  "$defs": {
    "text": { "type": "string", "minLength": 1 },
    "hash": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
    "time": {
      "type": "string",
      "format": "date-time",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}\\.[0-9]{3}Z$"
    },
    "int": { "type": "integer", "minimum": -9007199254740991, "maximum": 9007199254740991 },
    "count": { "type": "integer", "minimum": 0, "maximum": 9007199254740991 },
    "ordinal": { "type": "integer", "minimum": 1, "maximum": 9007199254740991 },
    "key_value": { "anyOf": [{ "$ref": "#/$defs/text" }, { "$ref": "#/$defs/int" }] },
    "scalar": { "anyOf": [{ "type": "string" }, { "$ref": "#/$defs/int" }, { "type": "boolean" }] },
    "status": { "enum": ["open", "resolved", "dismissed"] },
    "outcome": { "enum": ["met", "not_met", "unknown"] },
    "subject": {
      "type": "object",
      "required": ["type", "keys"],
      "additionalProperties": false,
      "properties": {
        "type": { "$ref": "#/$defs/text" },
        "keys": { "type": "object", "minProperties": 1, "additionalProperties": { "$ref": "#/$defs/key_value" } }
      }
    },
    "evidence_list": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["obs_id", "digest"],
        "additionalProperties": false,
        "properties": { "obs_id": { "$ref": "#/$defs/text" }, "digest": { "$ref": "#/$defs/hash" } }
      }
    },

    "match": {
      "type": "object",
      "minProperties": 1,
      "maxProperties": 3,
      "additionalProperties": { "$ref": "#/$defs/text" }
    },
    "rule": {
      "anyOf": [
        {
          "type": "object",
          "required": ["kind", "match"],
          "additionalProperties": false,
          "properties": {
            "kind": { "$ref": "#/$defs/text" },
            "match": { "$ref": "#/$defs/match" },
            "where": { "type": "object", "minProperties": 1, "additionalProperties": { "$ref": "#/$defs/scalar" } }
          }
        },
        {
          "type": "object",
          "required": ["kind", "match", "condition", "scope"],
          "additionalProperties": false,
          "properties": {
            "kind": { "$ref": "#/$defs/text" },
            "match": { "$ref": "#/$defs/match" },
            "condition": { "const": "absent" },
            "scope": { "const": "all" }
          }
        }
      ]
    },
    "rules": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/rule" } },
    "ruled_criterion": {
      "anyOf": [
        {
          "type": "object",
          "required": ["description", "rules"],
          "additionalProperties": false,
          "properties": { "description": { "$ref": "#/$defs/text" }, "rules": { "$ref": "#/$defs/rules" } }
        },
        {
          "type": "object",
          "required": ["description", "any_of"],
          "additionalProperties": false,
          "properties": {
            "description": { "$ref": "#/$defs/text" },
            "any_of": {
              "type": "array",
              "minItems": 2,
              "items": {
                "type": "object",
                "required": ["rules"],
                "additionalProperties": false,
                "properties": { "rules": { "$ref": "#/$defs/rules" } }
              }
            }
          }
        }
      ]
    },
    "closing_criterion": {
      "anyOf": [
        { "$ref": "#/$defs/ruled_criterion" },
        {
          "type": "object",
          "required": ["description"],
          "additionalProperties": false,
          "properties": { "description": { "$ref": "#/$defs/text" } }
        }
      ]
    },
    "attention_type": {
      "type": "object",
      "required": ["key", "description"],
      "additionalProperties": false,
      "properties": {
        "key": { "$ref": "#/$defs/text" },
        "description": { "$ref": "#/$defs/text" },
        "when": { "$ref": "#/$defs/rules" },
        "delivery": {
          "type": "object",
          "required": ["route"],
          "additionalProperties": false,
          "properties": { "route": { "$ref": "#/$defs/text" } }
        }
      }
    },

    "definition": {
      "type": "object",
      "required": ["id", "version", "identity", "accountable", "include", "closing", "success"],
      "additionalProperties": false,
      "properties": {
        "id": { "$ref": "#/$defs/text" },
        "version": { "$ref": "#/$defs/ordinal" },
        "identity": {
          "type": "object",
          "required": ["subject_type", "subject_keys"],
          "additionalProperties": false,
          "properties": {
            "subject_type": { "$ref": "#/$defs/text" },
            "subject_keys": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "$ref": "#/$defs/text" } }
          }
        },
        "accountable": { "$ref": "#/$defs/text" },
        "expectations": { "$ref": "#/$defs/text" },
        "include": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "$ref": "#/$defs/text" } },
        "closing": { "type": "array", "items": { "$ref": "#/$defs/closing_criterion" } },
        "success": { "type": "array", "items": { "$ref": "#/$defs/ruled_criterion" } },
        "attention_types": { "type": "array", "items": { "$ref": "#/$defs/attention_type" } }
      }
    },
    "observation": {
      "type": "object",
      "required": ["id", "kind", "occurred_at", "subjects", "rows", "complete"],
      "additionalProperties": false,
      "properties": {
        "id": { "$ref": "#/$defs/text" },
        "kind": { "$ref": "#/$defs/text" },
        "occurred_at": { "$ref": "#/$defs/time" },
        "subjects": { "type": "array", "items": { "$ref": "#/$defs/subject" } },
        "rows": { "type": "array", "items": { "type": "object" } },
        "complete": { "type": "boolean" }
      }
    },
    "observations": { "type": "array", "items": { "$ref": "#/$defs/observation" } },
    "proposal": {
      "type": "object",
      "required": ["subject", "status", "cites"],
      "additionalProperties": false,
      "properties": {
        "subject": { "$ref": "#/$defs/subject" },
        "status": { "enum": ["open", "resolved"] },
        "cites": { "type": "array", "uniqueItems": true, "items": { "$ref": "#/$defs/text" } },
        "title": { "$ref": "#/$defs/text" },
        "summary": { "$ref": "#/$defs/text" },
        "attentions": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["type", "intent", "reason"],
            "additionalProperties": false,
            "properties": {
              "type": { "$ref": "#/$defs/text" },
              "intent": { "enum": ["open", "keep", "close"] },
              "reason": { "type": "string" }
            }
          }
        }
      }
    },
    "proposed_improvement": {
      "type": "object",
      "required": ["key", "title", "change", "rationale", "cites"],
      "additionalProperties": false,
      "properties": {
        "key": { "$ref": "#/$defs/text" },
        "title": { "type": "string" },
        "change": { "type": "string" },
        "rationale": { "type": "string" },
        "cites": { "type": "array", "uniqueItems": true, "items": { "$ref": "#/$defs/text" } }
      }
    },
    "evaluation": {
      "type": "object",
      "required": ["basis", "evaluator", "proposals"],
      "additionalProperties": false,
      "properties": {
        "basis": { "$ref": "#/$defs/hash" },
        "evaluator": { "$ref": "#/$defs/text" },
        "proposals": { "type": "array", "items": { "$ref": "#/$defs/proposal" } },
        "improvements": { "type": "array", "items": { "$ref": "#/$defs/proposed_improvement" } }
      }
    },
    "command": {
      "anyOf": [
        {
          "type": "object",
          "required": ["actor", "case_id", "status"],
          "additionalProperties": false,
          "properties": {
            "actor": { "type": "string", "pattern": "^person:.+" },
            "case_id": { "$ref": "#/$defs/hash" },
            "status": { "enum": ["open", "resolved"] },
            "reason": { "$ref": "#/$defs/text" }
          }
        },
        {
          "type": "object",
          "required": ["actor", "case_id", "status", "reason"],
          "additionalProperties": false,
          "properties": {
            "actor": { "type": "string", "pattern": "^person:.+" },
            "case_id": { "$ref": "#/$defs/hash" },
            "status": { "const": "dismissed" },
            "reason": { "$ref": "#/$defs/text" }
          }
        }
      ]
    },
    "attention": {
      "type": "object",
      "required": ["status", "activation", "opened_at", "closed_at"],
      "additionalProperties": false,
      "properties": {
        "status": { "enum": ["open", "closed"] },
        "activation": { "$ref": "#/$defs/ordinal" },
        "opened_at": { "$ref": "#/$defs/time" },
        "closed_at": { "anyOf": [{ "$ref": "#/$defs/time" }, { "type": "null" }] }
      }
    },
    "case": {
      "type": "object",
      "required": [
        "subject", "status", "episode", "seq", "version", "title", "summary",
        "evidence", "first_observed", "last_observed", "attentions"
      ],
      "additionalProperties": false,
      "properties": {
        "subject": { "$ref": "#/$defs/subject" },
        "status": { "$ref": "#/$defs/status" },
        "episode": { "$ref": "#/$defs/ordinal" },
        "seq": { "$ref": "#/$defs/ordinal" },
        "version": { "$ref": "#/$defs/ordinal" },
        "title": { "anyOf": [{ "$ref": "#/$defs/text" }, { "type": "null" }] },
        "summary": { "anyOf": [{ "$ref": "#/$defs/text" }, { "type": "null" }] },
        "evidence": { "type": "object", "additionalProperties": { "$ref": "#/$defs/hash" } },
        "first_observed": { "$ref": "#/$defs/time" },
        "last_observed": { "$ref": "#/$defs/time" },
        "attentions": { "type": "object", "additionalProperties": { "$ref": "#/$defs/attention" } }
      }
    },
    "improvement": {
      "type": "object",
      "required": ["key", "title", "change", "rationale", "evidence", "proposed_at", "updated_at", "seq", "version"],
      "additionalProperties": false,
      "properties": {
        "key": { "$ref": "#/$defs/text" },
        "title": { "$ref": "#/$defs/text" },
        "change": { "$ref": "#/$defs/text" },
        "rationale": { "$ref": "#/$defs/text" },
        "evidence": { "type": "object", "minProperties": 1, "additionalProperties": { "$ref": "#/$defs/hash" } },
        "proposed_at": { "$ref": "#/$defs/time" },
        "updated_at": { "$ref": "#/$defs/time" },
        "seq": { "$ref": "#/$defs/ordinal" },
        "version": { "$ref": "#/$defs/ordinal" }
      }
    },
    "state": {
      "type": "object",
      "required": ["spec", "definition_id", "identity_digest", "now", "cases", "improvements"],
      "additionalProperties": false,
      "properties": {
        "spec": { "const": "responsibility-core/1" },
        "definition_id": { "$ref": "#/$defs/text" },
        "identity_digest": { "$ref": "#/$defs/hash" },
        "now": { "$ref": "#/$defs/time" },
        "cases": { "type": "object", "additionalProperties": { "$ref": "#/$defs/case" } },
        "improvements": { "type": "object", "additionalProperties": { "$ref": "#/$defs/improvement" } }
      }
    },
    "state_or_null": { "anyOf": [{ "type": "null" }, { "$ref": "#/$defs/state" }] },

    "view": {
      "type": "object",
      "required": ["spec", "basis", "observations", "cases", "attention_types", "improvements", "closing"],
      "additionalProperties": false,
      "properties": {
        "spec": { "const": "responsibility-core/1" },
        "basis": { "$ref": "#/$defs/hash" },
        "observations": { "$ref": "#/$defs/observations" },
        "cases": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "case_id", "subject", "status", "episode", "title", "summary",
              "evidence", "first_observed", "last_observed", "attentions"
            ],
            "additionalProperties": false,
            "properties": {
              "case_id": { "$ref": "#/$defs/hash" },
              "subject": { "$ref": "#/$defs/subject" },
              "status": { "$ref": "#/$defs/status" },
              "episode": { "$ref": "#/$defs/ordinal" },
              "title": {
                "description": "Earlier assessment by a judge, recorded in an earlier run: history, not evidence and not current truth.",
                "anyOf": [{ "$ref": "#/$defs/text" }, { "type": "null" }]
              },
              "summary": {
                "description": "Earlier assessment by a judge, recorded in an earlier run: history, not evidence and not current truth.",
                "anyOf": [{ "$ref": "#/$defs/text" }, { "type": "null" }]
              },
              "evidence": { "type": "array", "uniqueItems": true, "items": { "$ref": "#/$defs/text" } },
              "first_observed": { "$ref": "#/$defs/time" },
              "last_observed": { "$ref": "#/$defs/time" },
              "attentions": { "type": "array", "items": { "$ref": "#/$defs/text" } }
            }
          }
        },
        "attention_types": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["key", "description", "checked", "routed"],
            "additionalProperties": false,
            "properties": {
              "key": { "$ref": "#/$defs/text" },
              "description": { "$ref": "#/$defs/text" },
              "checked": { "type": "boolean" },
              "routed": { "type": "boolean" }
            }
          }
        },
        "improvements": {
          "description": "Earlier proposals by a judge, for a person to decide on: history, not evidence.",
          "type": "array",
          "items": {
            "type": "object",
            "required": ["key", "title", "change"],
            "additionalProperties": false,
            "properties": {
              "key": { "$ref": "#/$defs/text" },
              "title": { "$ref": "#/$defs/text" },
              "change": { "$ref": "#/$defs/text" }
            }
          }
        },
        "closing": { "type": "array", "items": { "$ref": "#/$defs/text" } },
        "expectations": { "$ref": "#/$defs/text" }
      }
    },
    "check": {
      "type": "object",
      "required": ["result", "criteria"],
      "additionalProperties": false,
      "properties": {
        "result": { "$ref": "#/$defs/outcome" },
        "criteria": { "type": "array", "items": { "$ref": "#/$defs/criterion_trace" } }
      }
    },
    "criterion_trace": {
      "type": "object",
      "required": ["description", "result", "routes"],
      "additionalProperties": false,
      "properties": {
        "description": { "$ref": "#/$defs/text" },
        "result": { "$ref": "#/$defs/outcome" },
        "routes": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["result", "rules"],
            "additionalProperties": false,
            "properties": {
              "result": { "$ref": "#/$defs/outcome" },
              "rules": {
                "type": "array",
                "items": {
                  "type": "object",
                  "required": ["kind", "condition", "observation", "result", "reason"],
                  "additionalProperties": false,
                  "properties": {
                    "kind": { "$ref": "#/$defs/text" },
                    "condition": { "enum": ["present", "absent"] },
                    "observation": { "anyOf": [{ "$ref": "#/$defs/text" }, { "type": "null" }] },
                    "result": { "$ref": "#/$defs/outcome" },
                    "reason": { "$ref": "#/$defs/text" }
                  }
                }
              }
            }
          }
        }
      }
    },
    "transition": {
      "type": "object",
      "required": ["id", "case_id", "kind", "from", "to", "actor", "added_evidence", "version", "at"],
      "additionalProperties": false,
      "properties": {
        "id": { "$ref": "#/$defs/hash" },
        "case_id": { "$ref": "#/$defs/hash" },
        "kind": { "enum": ["opened", "status_changed", "updated"] },
        "from": { "anyOf": [{ "$ref": "#/$defs/status" }, { "type": "null" }] },
        "to": { "$ref": "#/$defs/status" },
        "actor": { "type": "string", "pattern": "^(judge|person):.+" },
        "reason": { "$ref": "#/$defs/text" },
        "added_evidence": { "$ref": "#/$defs/evidence_list" },
        "title": { "$ref": "#/$defs/text" },
        "summary": { "$ref": "#/$defs/text" },
        "closing_check": { "$ref": "#/$defs/check" },
        "version": { "$ref": "#/$defs/ordinal" },
        "at": { "$ref": "#/$defs/time" }
      }
    },
    "attention_event": {
      "type": "object",
      "required": ["id", "case_id", "type", "event", "activation", "actor", "reason", "proposal", "version", "at"],
      "additionalProperties": false,
      "properties": {
        "id": { "$ref": "#/$defs/hash" },
        "case_id": { "$ref": "#/$defs/hash" },
        "type": { "$ref": "#/$defs/text" },
        "event": { "enum": ["opened", "reopened", "closed"] },
        "activation": { "$ref": "#/$defs/ordinal" },
        "actor": { "type": "string", "pattern": "^judge:.+" },
        "reason": { "$ref": "#/$defs/text" },
        "proposal": { "$ref": "#/$defs/hash" },
        "gate_check": { "$ref": "#/$defs/check" },
        "version": { "$ref": "#/$defs/ordinal" },
        "at": { "$ref": "#/$defs/time" }
      }
    },
    "delivery": {
      "type": "object",
      "required": ["id", "case_id", "subject", "type", "activation", "route", "reason", "event_id"],
      "additionalProperties": false,
      "properties": {
        "id": { "$ref": "#/$defs/hash" },
        "case_id": { "$ref": "#/$defs/hash" },
        "subject": { "$ref": "#/$defs/subject" },
        "type": { "$ref": "#/$defs/text" },
        "activation": { "$ref": "#/$defs/ordinal" },
        "route": { "$ref": "#/$defs/text" },
        "reason": { "$ref": "#/$defs/text" },
        "event_id": { "$ref": "#/$defs/hash" }
      }
    },
    "improvement_event": {
      "type": "object",
      "required": ["id", "improvement_id", "key", "kind", "actor", "added_evidence", "version", "at"],
      "additionalProperties": false,
      "properties": {
        "id": { "$ref": "#/$defs/hash" },
        "improvement_id": { "$ref": "#/$defs/hash" },
        "key": { "$ref": "#/$defs/text" },
        "kind": { "enum": ["proposed", "updated"] },
        "actor": { "type": "string", "pattern": "^judge:.+" },
        "added_evidence": { "$ref": "#/$defs/evidence_list" },
        "title": { "$ref": "#/$defs/text" },
        "change": { "$ref": "#/$defs/text" },
        "rationale": { "$ref": "#/$defs/text" },
        "version": { "$ref": "#/$defs/ordinal" },
        "at": { "$ref": "#/$defs/time" }
      }
    },
    "rejection": {
      "type": "object",
      "required": ["ref", "code", "detail"],
      "additionalProperties": false,
      "properties": {
        "ref": {
          "anyOf": [
            {
              "type": "object",
              "required": ["proposal", "part"],
              "additionalProperties": false,
              "properties": {
                "proposal": { "$ref": "#/$defs/hash" },
                "case_id": { "$ref": "#/$defs/hash" },
                "part": { "enum": ["proposal", "status", "attention"] },
                "key": { "$ref": "#/$defs/text" }
              }
            },
            {
              "type": "object",
              "required": ["improvement", "part", "key"],
              "additionalProperties": false,
              "properties": {
                "improvement": { "$ref": "#/$defs/hash" },
                "part": { "const": "improvement" },
                "key": { "$ref": "#/$defs/text" }
              }
            }
          ]
        },
        "code": {
          "enum": [
            "BASIS_MISMATCH", "UNKNOWN_EVIDENCE", "NO_EVIDENCE", "IDENTITY_MISMATCH",
            "CONFLICTING_PROPOSALS", "STATUS_NOT_ALLOWED", "CLOSING_NOT_MET",
            "REOPEN_WHILE_CLOSING_MET", "STATUS_UNCHANGED_NO_NEW_EVIDENCE", "ATTENTION_REPEATED",
            "ATTENTION_NO_REASON", "ATTENTION_NOT_DECLARED", "ATTENTION_CASE_NOT_OPEN",
            "ATTENTION_GATE_NOT_MET", "IMPROVEMENT_CONFLICT", "IMPROVEMENT_INCOMPLETE"
          ]
        },
        "detail": {
          "type": "object",
          "required": ["message"],
          "additionalProperties": false,
          "properties": {
            "message": { "$ref": "#/$defs/text" },
            "expected": { "$ref": "#/$defs/hash" },
            "received": { "$ref": "#/$defs/hash" },
            "unknown": { "type": "array", "items": { "$ref": "#/$defs/text" } },
            "closing_check": { "$ref": "#/$defs/check" },
            "gate_check": { "$ref": "#/$defs/check" },
            "proposed_title": { "$ref": "#/$defs/text" },
            "proposed_summary": { "$ref": "#/$defs/text" }
          }
        }
      }
    },
    "step_result": {
      "type": "object",
      "required": ["spec", "state", "transitions", "attention_events", "deliveries", "improvement_events", "rejections", "state_digest"],
      "additionalProperties": false,
      "properties": {
        "spec": { "const": "responsibility-core/1" },
        "state": { "$ref": "#/$defs/state_or_null" },
        "transitions": { "type": "array", "items": { "$ref": "#/$defs/transition" } },
        "attention_events": { "type": "array", "items": { "$ref": "#/$defs/attention_event" } },
        "deliveries": { "type": "array", "items": { "$ref": "#/$defs/delivery" } },
        "improvement_events": { "type": "array", "items": { "$ref": "#/$defs/improvement_event" } },
        "rejections": { "type": "array", "items": { "$ref": "#/$defs/rejection" } },
        "state_digest": { "$ref": "#/$defs/hash" }
      }
    },
    "assessment": {
      "type": "object",
      "required": ["spec", "case_id", "result", "criteria"],
      "additionalProperties": false,
      "properties": {
        "spec": { "const": "responsibility-core/1" },
        "case_id": { "$ref": "#/$defs/hash" },
        "result": { "$ref": "#/$defs/outcome" },
        "criteria": { "type": "array", "items": { "$ref": "#/$defs/criterion_trace" } }
      }
    }
  }
}
